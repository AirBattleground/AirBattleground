{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@7xen/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "zod": [
        "./node_modules/zod"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/gameops/src/GameOps.types.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "modules/gameops/android"
  ]
}
