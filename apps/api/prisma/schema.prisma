generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  PLAYER
}

/// phase 5: players & teams (docs/phase5/PLAYERS.md)
enum TeamRole {
  LEADER
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SuggestionKind {
  SCRIM
  TOURNAMENT
}

enum SuggestionStatus {
  OPEN
  DONE
  DISMISSED
}

enum Recurrence {
  ONCE
  DAILY
  WEEKENDS
}

enum ScrimStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  LINEUP_REVIEW
  LIVE
  RESULTS_REVIEW
  PUBLISHED
}

enum ScreenshotKind {
  SLOT_LIST
  RESULTS
}

enum ScreenshotStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum SampleSplit {
  TRAIN
  TEST
}

enum SampleSource {
  ADMIN_UPLOAD
  MANAGER_CORRECTION
  SEED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum TournamentMode {
  BR
  TDM
}

enum StageStatus {
  PENDING
  DRAWN
  LIVE
  COMPLETED
}

enum EntryType {
  REGISTERED
  INVITED
}

enum EntryStatus {
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  REMOVED
}

enum GroupTeamStatus {
  ACTIVE
  ADVANCED
  ELIMINATED
  DISQUALIFIED
}

enum RecordingStatus {
  LIVE
  STOPPED
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Every account is a User. Admin/managers: username + password issued by the admin. Players (phase 5): Google sign-in.
model User {
  id           String    @id @default(cuid())
  /// stored lowercase; null for players
  username     String?   @unique
  /// null for players (they sign in with Google)
  passwordHash String?
  role         Role
  displayName  String
  /// players: verified Google email (lowercase, unique). Managers: optional contact email.
  email        String?   @unique
  phone        String?
  /// phase 5 players: Google "sub" claim
  googleSub    String?   @unique
  /// Google profile picture
  avatarUrl    String?
  /// photo the player uploaded (storage key under branding/); shown instead of the Google avatarUrl, which sign-in refreshes
  avatarKey    String?
  /// in-game name (required after onboarding)
  ign          String?
  /// BGMI character id, digits only (required before creating/joining a team)
  bgmiId       String?   @unique
  /// phase 7c: player's portal language — "en" | "hi" | "hinglish" (null = follow the device)
  language     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// MANAGER: organisation logo shown to teams on scrims/tournaments (storage key under branding/)
  orgLogoKey   String?
  /// phase 5b MANAGER: organisation name (from the manager invitation)
  orgName      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  membership              TeamMember?
  ledTeam                 Team?               @relation("TeamLeader")
  joinRequests            TeamJoinRequest[]
  teamInvites             TeamInvite[]        @relation("TeamInviteInvitee")
  teamInvitesSent         TeamInvite[]        @relation("TeamInviteSender")
  suggestions             TeamSuggestion[]
  registeredRegistrations Registration[]      @relation("RegistrationRegisteredBy")
  registeredEntries       TournamentEntry[]   @relation("EntryRegisteredBy")
  matchPlayers            MatchPlayer[]
  scrims                  Scrim[]             @relation("ScrimManager")
  decidedRegistrations    Registration[]      @relation("RegistrationDecider")
  screenshots             Screenshot[]
  trainingSamples         TrainingSample[]
  tournaments             Tournament[]        @relation("TournamentManager")
  recordings              MatchRecording[]
  recipes                 Recipe[]
  managerInvitesSent      ManagerInvite[]     @relation("ManagerInviteInvitedBy")
  managerInviteAccepted   ManagerInvite[]     @relation("ManagerInviteAccepted")
  devices                 Device[]
  studioShows             StudioShow[]
  studioWorkers           StudioWorker[]
  streamLayout            StreamLayout?
  streamDestinations      StreamDestination[]
  coinAwards              CoinAward[]

  @@index([role])
}

/// phase 5b: the admin invites an organiser by email; they become a MANAGER on their first Google sign-in.
enum ManagerInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// At most one PENDING invite per email (partial unique index "ManagerInvite_one_pending" in SQL).
model ManagerInvite {
  id             String              @id @default(cuid())
  /// lowercase
  email          String
  name           String
  orgName        String
  status         ManagerInviteStatus @default(PENDING)
  invitedById    String?
  invitedBy      User?               @relation("ManagerInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUserId String?
  acceptedUser   User?               @relation("ManagerInviteAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  acceptedAt     DateTime?

  @@index([email])
  @@index([status, createdAt])
}

/// phase 5: a group of players with one leader (no login of its own).
model Team {
  id         String   @id @default(cuid())
  /// one team led per player (= the TeamMember row with role LEADER)
  leaderId   String   @unique
  leader     User     @relation("TeamLeader", fields: [leaderId], references: [id])
  /// 8 chars from INVITE_CODE_ALPHABET; rotatable
  inviteCode String   @unique
  /// optional team logo (storage key under branding/)
  logoKey    String?
  name       String
  /// teamNameKey(name): trimmed, single-spaced, lowercase — enforces unique team names
  nameKey    String   @unique
  tag        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  registrations     Registration[]
  members           TeamMember[]
  joinRequests      TeamJoinRequest[]
  suggestions       TeamSuggestion[]
  invites           TeamInvite[]
  /// legacy free-text roster (phase 2); no longer written — rosters come from members
  players           TeamPlayer[]
  matchTeams        MatchTeam[]
  tournamentEntries TournamentEntry[]
  groupSlots        GroupTeam[]
  championOf        Tournament[]      @relation("TournamentChampion")
  coinAwards        CoinAward[]
}

/// phase 5: one row per player in a team. userId is unique: a player is in at most ONE team.
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// exactly one LEADER per team (= Team.leaderId)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@index([teamId])
}

/// phase 5: a player asks to join a team via its invite code; the leader approves/rejects.
/// At most one PENDING per user (partial unique index "TeamJoinRequest_one_pending", see migration).
model TeamJoinRequest {
  id        String            @id @default(cuid())
  teamId    String
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  message   String?
  decidedAt DateTime?
  createdAt DateTime          @default(now())

  @@index([teamId, status])
  @@index([userId, status])
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

/// phase 5d: the leader invites a player by BGMI ID; the player accepts or declines.
/// At most one PENDING per (team, player): partial unique index "TeamInvite_one_pending" (see migration).
model TeamInvite {
  id          String           @id @default(cuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("TeamInviteInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User             @relation("TeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  status      TeamInviteStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([teamId, status])
  @@index([userId, status])
}

/// phase 5: a member asks the leader to register for a scrim (scrimId + date) or a tournament.
model TeamSuggestion {
  id           String           @id @default(cuid())
  teamId       String
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User             @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  kind         SuggestionKind
  scrimId      String?
  /// "YYYY-MM-DD" (IST) for SCRIM
  date         String?
  tournamentId String?
  note         String?
  status       SuggestionStatus @default(OPEN)
  createdAt    DateTime         @default(now())

  @@index([teamId, status])
}

/// Team roster (phase 2). Legacy: kept for old data, no longer written (phase 5 rosters = team members).
model TeamPlayer {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ign       String
  bgmiId    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

/// A scrim definition. It "occurs" on dates according to recurrence; see shared/schedule.ts occursOn().
model Scrim {
  id           String      @id @default(cuid())
  managerId    String
  manager      User        @relation("ScrimManager", fields: [managerId], references: [id])
  title        String
  description  String?
  /// GameMap values, one per match, in play order
  maps         String[]
  /// "HH:mm" in app timezone (IST)
  startTime    String
  recurrence   Recurrence
  startDate    DateTime    @db.Date
  endDate      DateTime?   @db.Date
  slotCount    Int
  firstSlot    Int         @default(1)
  status       ScrimStatus @default(ACTIVE)
  /// PointsSystem JSON { placement: number[], killPoints }; null = DEFAULT_POINTS_SYSTEM
  pointsSystem Json?
  /// poster image (storage key under branding/)
  posterKey    String?
  /// BG coins credited to the winning team's leader for each published match (0 = none)
  winCoins     Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions ScrimSession[]

  @@index([managerId])
  @@index([status, startDate])
}

/// One occurrence of a scrim on a date. Created lazily on first registration.
/// Phase 2 hangs room details, match results and screenshots off this.
model ScrimSession {
  id        String   @id @default(cuid())
  scrimId   String
  scrim     Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  registrations Registration[]
  matches       Match[]

  @@unique([scrimId, date])
  @@index([date])
}

model Registration {
  id              String             @id @default(cuid())
  sessionId       String
  session         ScrimSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status          RegistrationStatus @default(PENDING)
  /// set only while APPROVED
  slotNumber      Int?
  rejectionReason String?
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?              @relation("RegistrationDecider", fields: [decidedById], references: [id])
  /// phase 5: the leader who registered
  registeredById  String?
  registeredBy    User?              @relation("RegistrationRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  /// one row per team per session; re-registering after cancel/reject reuses the row
  @@unique([sessionId, teamId])
  /// NULLs are distinct in Postgres, so only allotted slots must be unique
  @@unique([sessionId, slotNumber])
  @@index([teamId, status])
  @@index([sessionId, status])
}

/// One match (map) of a scrim session. Created from scrim.maps when the manager opens the session.
model Match {
  id             String           @id @default(cuid())
  /// a match belongs to a scrim session OR a tournament group (exactly one is set)
  sessionId      String?
  session        ScrimSession?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupId        String?
  group          TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime?
  lobbyIndex     Int?
  /// phase 4: custom room details shared with teams (revealed at roomRevealAt; null = immediately)
  roomId         String?
  roomPassword   String?
  roomRevealAt   DateTime?
  roomUpdatedAt  DateTime?
  number         Int
  map            String
  status         MatchStatus      @default(SCHEDULED)
  publishedAt    DateTime?
  /// TDM: both teams had the same kills, so the manager picked the winner — their reason (shown to teams)
  tieNote        String?
  /// live team status for the studio Team Status board: { "<teamId>": [{ state, source, at }, …] } (services/liveStatus.ts)
  liveTeams      Json?
  /// the manager paused auto capture updates (captures are still accepted)
  liveAutoPaused Boolean          @default(false)
  /// capturedAt of the newest applied auto capture (older ones are dropped)
  liveAutoAt     DateTime?
  /// the board payload's version (= ETag); bumped whenever liveHash (a hash of the payload) changes
  liveVersion    Int              @default(0)
  liveHash       String?
  liveUpdatedAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  screenshots Screenshot[]
  teams       MatchTeam[]
  recordings  MatchRecording[]
  devices     Device[]
  coinAward   CoinAward?
  captures    LiveCapture[]

  @@unique([sessionId, number])
  @@unique([groupId, number])
  @@index([scheduledAt])
}

/// An uploaded screenshot; read asynchronously by the extractor (worker in apps/api).
enum LiveCaptureStatus {
  QUEUED
  PROCESSING
  /// read and applied (possibly with no changes)
  APPLIED
  /// not applied: superseded by a newer capture, match not live, or auto updates paused
  SKIPPED
  FAILED
}

/// An auto capture from 7XEN Studio (kind=LIVE_STATUS): a scene image read for live team status. Kept 24 h.
model LiveCapture {
  id          String            @id @default(cuid())
  matchId     String
  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  /// the studio (StudioWorker) that sent it
  workerId    String
  /// the studio's id for the image (idempotency)
  captureId   String
  sessionId   String
  sequence    Int
  capturedAt  DateTime
  sceneId     String?
  sceneName   String?
  storageKey  String
  mimeType    String
  width       Int?
  height      Int?
  status      LiveCaptureStatus @default(QUEUED)
  /// what the reader saw (LiveReadResult) + what was applied
  result      Json?
  /// players changed by this capture
  changes     Int?
  error       String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@unique([workerId, captureId])
  @@index([matchId, capturedAt])
  @@index([status, createdAt])
}

model Screenshot {
  id           String           @id @default(cuid())
  matchId      String
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind         ScreenshotKind
  /// path relative to STORAGE_DIR, e.g. screenshots/2026/10/<id>.jpg
  storageKey   String
  mimeType     String
  sha256       String
  width        Int?
  height       Int?
  status       ScreenshotStatus @default(QUEUED)
  /// "WEB" | "APP_AUTO" | "APP_MANUAL"
  source       String           @default("WEB")
  attempts     Int              @default(0)
  /// ExtractionResult JSON (camelCase, see shared/phase2.ts)
  extraction   Json?
  error        String?
  modelVersion String?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
  processedAt  DateTime?

  @@unique([matchId, sha256])
  @@index([status, createdAt])
}

/// A team (slot) in a match: lineup + result. Points are stored when published.
model MatchTeam {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  slotNumber      Int
  /// resolved from the session's APPROVED registration on this slot (null if none)
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  placement       Int?
  kills           Int?
  placementPoints Int?
  killPoints      Int?
  totalPoints     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players MatchPlayer[]

  @@unique([matchId, slotNumber])
  @@index([teamId])
}

model MatchPlayer {
  id            String    @id @default(cuid())
  matchTeamId   String
  matchTeam     MatchTeam @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  position      Int
  name          String
  ocrName       String?
  ocrConfidence Float?
  kills         Int?
  /// phase 5: the player account, when the name matches a team member's IGN
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([matchTeamId, position])
  @@index([userId])
}

/// Labelled screenshot used to evaluate/train the extractor. Image lives under STORAGE_DIR.
model TrainingSample {
  id           String         @id @default(cuid())
  kind         ScreenshotKind
  source       SampleSource
  storageKey   String
  sha256       String         @unique
  width        Int?
  height       Int?
  /// SlotListLabels | ResultsLabels JSON
  labels       Json
  split        SampleSplit    @default(TRAIN)
  verified     Boolean        @default(false)
  excluded     Boolean        @default(false)
  notes        String?
  screenshotId String?
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([kind, split])
}

/// Phase 3: a multi-stage tournament run by a manager. Plan: docs/phase3/TOURNAMENTS.md
model Tournament {
  id                   String           @id @default(cuid())
  managerId            String
  manager              User             @relation("TournamentManager", fields: [managerId], references: [id])
  title                String
  description          String?
  rules                String?
  prize                String?
  status               TournamentStatus @default(DRAFT)
  /// PointsSystem JSON; null = DEFAULT_POINTS_SYSTEM
  pointsSystem         Json?
  teamSize             Int              @default(4)
  firstSlot            Int              @default(1)
  maxTeams             Int
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  championTeamId       String?
  champion             Team?            @relation("TournamentChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  /// poster image (storage key under branding/)
  posterKey            String?
  /// BG coins credited to the winning team's leader — BR: each published match; TDM: the champion (0 = none)
  winCoins             Int              @default(0)
  /// phase 7: BR = classic tournament; TDM = knockout bracket of 2-team matches (shared/tournament/tdm.ts)
  mode                 TournamentMode   @default(BR)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  stages     TournamentStage[]
  entries    TournamentEntry[]
  coinAwards CoinAward[]

  @@index([status])
  @@index([managerId])
}

model TournamentStage {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// 1-based
  order           Int
  name            String
  status          StageStatus @default(PENDING)
  teamsIn         Int
  lobbySize       Int         @default(16)
  groupCount      Int
  matchesPerGroup Int
  /// GameMap per match
  maps            String[]
  advancePerGroup Int
  wildcardCount   Int         @default(0)
  invitedSlots    Int         @default(0)
  /// ScheduleConfig JSON
  schedule        Json?
  drawSeed        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  groups TournamentGroup[]

  @@unique([tournamentId, order])
}

/// A team's place in a tournament: a first-come-first-served registration or a manager invite.
model TournamentEntry {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type            EntryType   @default(REGISTERED)
  status          EntryStatus
  /// stage order the team enters at (1 = qualifier; invites can enter later)
  entryStage      Int         @default(1)
  /// TimeSlotOption ids (ISO start instants), most preferred first; empty = any time
  timePreferences String[]
  /// phase 5: the leader who registered
  registeredById  String?
  registeredBy    User?       @relation("EntryRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  registeredAt    DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  /// Finals Slot won on a scrim's Weekly Board: "weekly:<scrimId>:<monday YYYY-MM-DD>" (null = a plain invite)
  awardKey        String?
  /// shown on the team's Finals Slot card, e.g. "Night Royale · Weekly Board #1 · 19–23 Oct"
  awardNote       String?

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status, registeredAt])
  @@index([awardKey])
}

model TournamentGroup {
  id         String          @id @default(cuid())
  stageId    String
  stage      TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  index      Int
  name       String
  lobbyIndex Int?
  /// TimeSlotOption id (ISO) this group plays in
  slotId     String?
  startsAt   DateTime?
  createdAt  DateTime        @default(now())

  teams   GroupTeam[]
  matches Match[]

  @@unique([stageId, index])
}

model GroupTeam {
  id          String          @id @default(cuid())
  groupId     String
  group       TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slotNumber  Int
  seed        Int?
  status      GroupTeamStatus @default(ACTIVE)
  /// "TOP" | "WILDCARD" when ADVANCED
  advancedVia String?
  finalRank   Int?
  dqReason    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([groupId, teamId])
  @@unique([groupId, slotNumber])
  @@index([teamId])
}

/// Phase 4: a full-match screen recording made by the manager app (video uploaded to VIDEO_DIR).
model MatchRecording {
  id            String          @id @default(cuid())
  matchId       String
  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  managerId     String
  manager       User            @relation(fields: [managerId], references: [id])
  status        RecordingStatus @default(LIVE)
  deviceName    String?
  appVersion    String?
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  durationSec   Int?
  /// path relative to VIDEO_DIR
  videoKey      String?
  posterKey     String?
  sizeBytes     BigInt?
  uploadedBytes BigInt          @default(0)
  width         Int?
  height        Int?
  /// RecordingEvent[] JSON
  events        Json            @default("[]")
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([matchId])
  @@index([status, createdAt])
}

/// Phase 4: assisted/automatic touch steps for the manager app (admin default or a manager's taught copy).
model Recipe {
  id            String   @id @default(cuid())
  key           String
  name          String
  version       Int      @default(1)
  /// null = admin default
  managerId     String?
  manager       User?    @relation(fields: [managerId], references: [id], onDelete: Cascade)
  deviceProfile String?
  /// RecipeStep[] JSON
  steps         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, managerId])
}

/// Phase 4: small key/value settings (e.g. videoRetentionDays).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum DevicePlatform {
  IOS
}

/// Phase 6: a manager's streaming phone (view-only). The phone authenticates with its key (X-Device-Key).
model Device {
  id              String         @id @default(cuid())
  managerId       String
  manager         User           @relation(fields: [managerId], references: [id], onDelete: Cascade)
  name            String
  platform        DevicePlatform @default(IOS)
  /// sha256(key) hex — lookup
  keyHash         String         @unique
  /// AES-256-GCM(key) so the manager can show it again
  keyEnc          String
  keyPrefix       String
  model           String?
  osVersion       String?
  appVersion      String?
  lastSeenAt      DateTime?
  /// IDLE | LIVE as last reported by the phone
  state           String         @default("IDLE")
  streamingSince  DateTime?
  /// DeviceHealth JSON from the last heartbeat
  health          Json?
  /// phase 6b: the match the broadcast layout shows
  matchId         String?
  match           Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  /// phase 6c: the manager pressed "Start broadcast": teams in `match` may watch this phone's stream
  broadcastLive      Boolean   @default(false)
  broadcastStartedAt DateTime?
  /// phase 6b: composed output wanted on (survives API restarts) + where it pushes
  outputOn        Boolean        @default(false)
  outputDestIds   String[]       @default([])
  outputStartedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([managerId])
}

/// Phase 6b: a manager's broadcast layout (one per manager for now).
model StreamLayout {
  id        String   @id @default(cuid())
  managerId String   @unique
  manager   User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  /// StreamLayoutConfig JSON
  config    Json
  /// SponsorLogo storage keys: [{ id, key }]
  sponsors  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

/// Phase 6b: where a manager's broadcast output is pushed (YouTube, Facebook, any RTMP).
model StreamDestination {
  id        String   @id @default(cuid())
  managerId String
  manager   User     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  url       String
  /// AES-256-GCM(stream key)
  keyEnc    String
  keyHint   String
  createdAt DateTime @default(now())

  @@index([managerId])
}

/// BG coins: the winner (placement #1) of a published match earns its scrim's/tournament's winCoins, credited to the
/// team's leader at publish time. One row per match; removed when the match is unpublished.
/// TDM battles pay the champion instead: one row per tournament (tournamentId set, matchId null).
model CoinAward {
  id           String      @id @default(cuid())
  matchId      String?     @unique
  match        Match?      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentId String?     @unique
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// the team's leader when the coins were awarded
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([userId])
}

/// Phase 8: a Studio show — mixed in the manager's browser, sent in chunks, broadcast at live/show_<id>.
model StudioShow {
  id             String    @id @default(cuid())
  managerId      String
  manager        User      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  title          String
  /// the match the scorecard/MVP sources read (optional)
  matchId        String?
  /// IDLE | LIVE | ENDED
  state          String    @default("IDLE")
  liveSince      DateTime?
  /// StreamDestination ids relayed to while live
  destinationIds String[]  @default([])
  /// listed on the public AirBattleground Live/Watch pages while live (off = private test stream)
  publicListing  Boolean   @default(true)
  /// also go live on the site YouTube channel (when the admin connected one)
  siteYoutube    Boolean   @default(true)
  /// phase 8c: "Record on this box" — the box only saves the show to its disk, nothing is sent anywhere
  recordLocal    Boolean   @default(false)
  /// started by a connected 7XEN Studio app (studio-link): the app pushes to the outputs itself (box mode, no relays)
  studioLink     Boolean   @default(false)
  /// the Studio page's saved setup (scenes, overlays…); shape owned by the web app
  config         Json      @default("{}")
  /// phase 8b: "browser" (the Studio tab mixes it) | "worker" (a StudioWorker renders it)
  runOn          String    @default("browser")
  /// the StudioWorker running it (runOn "worker")
  workerId       String?
  /// live switching state mirrored to the worker ({ programId, takeSeq })
  control        Json?
  /// bumped on every control/config/match/title change (render page long-polls it)
  controlVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([managerId])
  @@index([state])
}

/// phase 8b: a manager's own computer that renders + encodes Studio shows (services/studio-worker)
model StudioWorker {
  id          String    @id @default(cuid())
  managerId   String
  manager     User      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  name        String
  /// sha256 hex of the worker key (sent as X-Worker-Key)
  keyHash     String    @unique
  lastSeenAt  DateTime?
  /// idle | starting | live | error (as last reported)
  state       String    @default("idle")
  encoder     String?
  version     String?
  showId      String?
  fps         Float?
  bitrateKbps Float?
  error       String?
  /// phase 8c: Studio Box info from the last poll (null = not a box)
  boxLanUrl    String?
  boxDevices   Int?
  boxStreaming Int?
  /// studio-link: last call from a connected 7XEN Studio app with this key (online while recent)
  linkSeenAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([managerId])
}
