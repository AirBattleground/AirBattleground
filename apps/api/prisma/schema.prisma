generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  TEAM
}

enum Recurrence {
  ONCE
  DAILY
  WEEKENDS
}

enum ScrimStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TeamRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  LINEUP_REVIEW
  LIVE
  RESULTS_REVIEW
  PUBLISHED
}

enum ScreenshotKind {
  SLOT_LIST
  RESULTS
}

enum ScreenshotStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum SampleSplit {
  TRAIN
  TEST
}

enum SampleSource {
  ADMIN_UPLOAD
  MANAGER_CORRECTION
  SEED
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  DRAWN
  LIVE
  COMPLETED
}

enum EntryType {
  REGISTERED
  INVITED
}

enum EntryStatus {
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  REMOVED
}

enum GroupTeamStatus {
  ACTIVE
  ADVANCED
  ELIMINATED
  DISQUALIFIED
}

enum RecordingStatus {
  LIVE
  STOPPED
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Every login (admin, manager, team) is a User. Credentials are issued by the admin.
model User {
  id           String    @id @default(cuid())
  /// stored lowercase
  username     String    @unique
  passwordHash String
  role         Role
  displayName  String
  email        String?
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// MANAGER: organisation logo shown to teams on scrims/tournaments (storage key under branding/)
  orgLogoKey   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team               Team?
  scrims             Scrim[]        @relation("ScrimManager")
  decidedRegistrations Registration[] @relation("RegistrationDecider")
  teamRequests       TeamRequest[]  @relation("TeamRequestManager")
  screenshots        Screenshot[]
  trainingSamples    TrainingSample[]
  tournaments        Tournament[]   @relation("TournamentManager")
  recordings         MatchRecording[]
  recipes            Recipe[]
  reviewedTeamRequests TeamRequest[] @relation("TeamRequestReviewer")

  @@index([role])
}

model Team {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// teamNameKey(name): trimmed, single-spaced, lowercase — enforces unique team names
  nameKey     String   @unique
  tag         String
  captainName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations Registration[]
  /// set when the team came from a manager's request
  request       TeamRequest?
  players       TeamPlayer[]
  matchTeams    MatchTeam[]
  tournamentEntries TournamentEntry[]
  groupSlots    GroupTeam[]
  championOf    Tournament[]   @relation("TournamentChampion")
}

/// Team roster (phase 2). Used to match OCR'd names to teams.
model TeamPlayer {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ign       String
  bgmiId    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

/// A manager asks for a team login. It becomes a real User + Team only when the admin approves.
/// Name/username uniqueness among PENDING requests is enforced by partial unique indexes (see migration).
model TeamRequest {
  id              String            @id @default(cuid())
  managerId       String
  manager         User              @relation("TeamRequestManager", fields: [managerId], references: [id])
  teamName        String
  /// teamNameKey(teamName)
  nameKey         String
  tag             String
  captainName     String?
  /// stored lowercase
  username        String
  passwordHash    String
  email           String?
  phone           String?
  status          TeamRequestStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?             @relation("TeamRequestReviewer", fields: [reviewedById], references: [id])
  teamId          String?           @unique
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([managerId, status])
}

/// A scrim definition. It "occurs" on dates according to recurrence; see shared/schedule.ts occursOn().
model Scrim {
  id          String      @id @default(cuid())
  managerId   String
  manager     User        @relation("ScrimManager", fields: [managerId], references: [id])
  title       String
  description String?
  /// GameMap values, one per match, in play order
  maps        String[]
  /// "HH:mm" in app timezone (IST)
  startTime   String
  recurrence  Recurrence
  startDate   DateTime    @db.Date
  endDate     DateTime?   @db.Date
  slotCount   Int
  firstSlot   Int         @default(1)
  status      ScrimStatus @default(ACTIVE)
  /// PointsSystem JSON { placement: number[], killPoints }; null = DEFAULT_POINTS_SYSTEM
  pointsSystem Json?
  /// poster image (storage key under branding/)
  posterKey   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sessions ScrimSession[]

  @@index([managerId])
  @@index([status, startDate])
}

/// One occurrence of a scrim on a date. Created lazily on first registration.
/// Phase 2 hangs room details, match results and screenshots off this.
model ScrimSession {
  id        String   @id @default(cuid())
  scrimId   String
  scrim     Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  registrations Registration[]
  matches       Match[]

  @@unique([scrimId, date])
  @@index([date])
}

model Registration {
  id              String             @id @default(cuid())
  sessionId       String
  session         ScrimSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status          RegistrationStatus @default(PENDING)
  /// set only while APPROVED
  slotNumber      Int?
  rejectionReason String?
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?              @relation("RegistrationDecider", fields: [decidedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  /// one row per team per session; re-registering after cancel/reject reuses the row
  @@unique([sessionId, teamId])
  /// NULLs are distinct in Postgres, so only allotted slots must be unique
  @@unique([sessionId, slotNumber])
  @@index([teamId, status])
  @@index([sessionId, status])
}

/// One match (map) of a scrim session. Created from scrim.maps when the manager opens the session.
model Match {
  id          String       @id @default(cuid())
  /// a match belongs to a scrim session OR a tournament group (exactly one is set)
  sessionId   String?
  session     ScrimSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groupId     String?
  group       TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  lobbyIndex  Int?
  /// phase 4: custom room details shared with teams (revealed at roomRevealAt; null = immediately)
  roomId        String?
  roomPassword  String?
  roomRevealAt  DateTime?
  roomUpdatedAt DateTime?
  number      Int
  map         String
  status      MatchStatus  @default(SCHEDULED)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  screenshots Screenshot[]
  teams       MatchTeam[]
  recordings  MatchRecording[]

  @@unique([sessionId, number])
  @@unique([groupId, number])
  @@index([scheduledAt])
}

/// An uploaded screenshot; read asynchronously by the extractor (worker in apps/api).
model Screenshot {
  id           String           @id @default(cuid())
  matchId      String
  match        Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  kind         ScreenshotKind
  /// path relative to STORAGE_DIR, e.g. screenshots/2026/10/<id>.jpg
  storageKey   String
  mimeType     String
  sha256       String
  width        Int?
  height       Int?
  status       ScreenshotStatus @default(QUEUED)
  /// "WEB" | "APP_AUTO" | "APP_MANUAL"
  source       String           @default("WEB")
  attempts     Int              @default(0)
  /// ExtractionResult JSON (camelCase, see shared/phase2.ts)
  extraction   Json?
  error        String?
  modelVersion String?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())
  processedAt  DateTime?

  @@unique([matchId, sha256])
  @@index([status, createdAt])
}

/// A team (slot) in a match: lineup + result. Points are stored when published.
model MatchTeam {
  id              String        @id @default(cuid())
  matchId         String
  match           Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  slotNumber      Int
  /// resolved from the session's APPROVED registration on this slot (null if none)
  teamId          String?
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  placement       Int?
  kills           Int?
  placementPoints Int?
  killPoints      Int?
  totalPoints     Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  players MatchPlayer[]

  @@unique([matchId, slotNumber])
  @@index([teamId])
}

model MatchPlayer {
  id            String    @id @default(cuid())
  matchTeamId   String
  matchTeam     MatchTeam @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  position      Int
  name          String
  ocrName       String?
  ocrConfidence Float?
  kills         Int?

  @@unique([matchTeamId, position])
}

/// Labelled screenshot used to evaluate/train the extractor. Image lives under STORAGE_DIR.
model TrainingSample {
  id           String         @id @default(cuid())
  kind         ScreenshotKind
  source       SampleSource
  storageKey   String
  sha256       String         @unique
  width        Int?
  height       Int?
  /// SlotListLabels | ResultsLabels JSON
  labels       Json
  split        SampleSplit    @default(TRAIN)
  verified     Boolean        @default(false)
  excluded     Boolean        @default(false)
  notes        String?
  screenshotId String?
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([kind, split])
}

/// Phase 3: a multi-stage tournament run by a manager. Plan: docs/phase3/TOURNAMENTS.md
model Tournament {
  id                   String           @id @default(cuid())
  managerId            String
  manager              User             @relation("TournamentManager", fields: [managerId], references: [id])
  title                String
  description          String?
  rules                String?
  prize                String?
  status               TournamentStatus @default(DRAFT)
  /// PointsSystem JSON; null = DEFAULT_POINTS_SYSTEM
  pointsSystem         Json?
  teamSize             Int              @default(4)
  firstSlot            Int              @default(1)
  maxTeams             Int
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  championTeamId       String?
  champion             Team?            @relation("TournamentChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  /// poster image (storage key under branding/)
  posterKey            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  stages  TournamentStage[]
  entries TournamentEntry[]

  @@index([status])
  @@index([managerId])
}

model TournamentStage {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// 1-based
  order           Int
  name            String
  status          StageStatus @default(PENDING)
  teamsIn         Int
  lobbySize       Int         @default(16)
  groupCount      Int
  matchesPerGroup Int
  /// GameMap per match
  maps            String[]
  advancePerGroup Int
  wildcardCount   Int         @default(0)
  invitedSlots    Int         @default(0)
  /// ScheduleConfig JSON
  schedule        Json?
  drawSeed        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  groups TournamentGroup[]

  @@unique([tournamentId, order])
}

/// A team's place in a tournament: a first-come-first-served registration or a manager invite.
model TournamentEntry {
  id              String      @id @default(cuid())
  tournamentId    String
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type            EntryType   @default(REGISTERED)
  status          EntryStatus
  /// stage order the team enters at (1 = qualifier; invites can enter later)
  entryStage      Int         @default(1)
  /// TimeSlotOption ids (ISO start instants), most preferred first; empty = any time
  timePreferences String[]
  registeredAt    DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status, registeredAt])
}

model TournamentGroup {
  id         String          @id @default(cuid())
  stageId    String
  stage      TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  index      Int
  name       String
  lobbyIndex Int?
  /// TimeSlotOption id (ISO) this group plays in
  slotId     String?
  startsAt   DateTime?
  createdAt  DateTime        @default(now())

  teams   GroupTeam[]
  matches Match[]

  @@unique([stageId, index])
}

model GroupTeam {
  id          String          @id @default(cuid())
  groupId     String
  group       TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slotNumber  Int
  seed        Int?
  status      GroupTeamStatus @default(ACTIVE)
  /// "TOP" | "WILDCARD" when ADVANCED
  advancedVia String?
  finalRank   Int?
  dqReason    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([groupId, teamId])
  @@unique([groupId, slotNumber])
  @@index([teamId])
}

/// Phase 4: a full-match screen recording made by the manager app (video uploaded to VIDEO_DIR).
model MatchRecording {
  id            String          @id @default(cuid())
  matchId       String
  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  managerId     String
  manager       User            @relation(fields: [managerId], references: [id])
  status        RecordingStatus @default(LIVE)
  deviceName    String?
  appVersion    String?
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  durationSec   Int?
  /// path relative to VIDEO_DIR
  videoKey      String?
  posterKey     String?
  sizeBytes     BigInt?
  uploadedBytes BigInt          @default(0)
  width         Int?
  height        Int?
  /// RecordingEvent[] JSON
  events        Json            @default("[]")
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([matchId])
  @@index([status, createdAt])
}

/// Phase 4: assisted/automatic touch steps for the manager app (admin default or a manager's taught copy).
model Recipe {
  id            String   @id @default(cuid())
  key           String
  name          String
  version       Int      @default(1)
  /// null = admin default
  managerId     String?
  manager       User?    @relation(fields: [managerId], references: [id], onDelete: Cascade)
  deviceProfile String?
  /// RecipeStep[] JSON
  steps         Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, managerId])
}

/// Phase 4: small key/value settings (e.g. videoRetentionDays).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
