NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sevenxen:sevenxen@localhost:5433/sevenxen?schema=public
# long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=7
# comma-separated origins allowed for CORS (dev uses Vite proxy, so this is for prod/split hosting)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Seeded admin account (prisma/seed.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=7xen Admin
# phase 5b: "Continue with Google" with this email signs in as the admin above (default airbattleground@gmail.com)
ADMIN_EMAIL=airbattleground@gmail.com
# Create demo managers/teams/scrims when seeding (dev only)
SEED_DEMO=1

# phase 4b: 7XEN Station on the host (see docs/phase4/STATION.md); same token as services/station/.env
STATION_URL=http://127.0.0.1:4500
STATION_TOKEN=

# phase 5: players sign in with Google. OAuth "Web application" client id (web reads it from /api/auth/config).
GOOGLE_CLIENT_ID=
# phase 5b: optional, unused for now (ID-token sign-in only needs the client id)
GOOGLE_CLIENT_SECRET=
# phase 5: dev-only player login by email (no Google needed). Ignored when NODE_ENV=production.
PLAYER_DEV_LOGIN=1

# phase 6: MediaMTX (docker-compose service "media"; see docs/phase6/IPHONE_STREAMING.md)
MEDIA_HLS_URL=http://127.0.0.1:8888
MEDIA_API_URL=http://127.0.0.1:9997
# what phones are told to publish to — use this machine's LAN IP / domain so the phone can reach it
MEDIA_RTMP_URL=rtmp://localhost:1935/live
