{
  "name": "7xen",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @7xen/api dev",
    "dev:web": "pnpm --filter @7xen/web dev",
    "dev:admin": "pnpm --filter @7xen/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker-compose up -d db",
    "db:migrate": "pnpm --filter @7xen/api db:migrate",
    "db:seed": "pnpm --filter @7xen/api db:seed",
    "db:studio": "pnpm --filter @7xen/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
