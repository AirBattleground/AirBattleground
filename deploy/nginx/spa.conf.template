# 7xen SPA server (web + admin images).
# Rendered by the nginx image's envsubst at start-up: ${API_UPSTREAM} defaults to http://api:4000.
# Only variables that are set in the environment are substituted, so $uri etc. stay intact.

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 2m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Same-origin API: the browser talks to this server, which proxies /api to the API
    # container, so the httpOnly session cookie needs no CORS.
    location /api/ {
        # screenshot uploads: up to 10 files x 10 MB per request (see MAX_SCREENSHOT_BYTES in shared)
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # reading a large screenshot (preview) can take a few seconds on CPU
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 7XEN Station live streams (HLS): small files polled every ~2 s. Pass them straight through
    # (no proxy buffering/caching) so a new playlist/segment reaches viewers immediately.
    location /api/live/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        gzip off;
    }

    # Vite emits content-hashed assets: cache them forever.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # Admin console (only present in the web image): same origin as the portal, at /admin-ui.
    location /admin-ui/ {
        try_files $uri /admin-ui/index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
    location = /admin-ui { return 301 /admin-ui/; }

    # SPA fallback: client-side routes resolve to index.html, which is never cached.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
