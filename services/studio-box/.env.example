# 7XEN Studio Box settings. Copy to .env (cp .env.example .env).
# The key of this box from the website: Studio → Studio boxes → Add (same key goes into ../studio-worker/.env as WORKER_KEY)
BOX_KEY=
# Name shown on the phones and in the Studio
BOX_NAME=Studio box
# API_URL=https://airbattleground.com
# PORT=4300
# LAN address phones use; auto-detected (first private IPv4) when empty
# LAN_HOST=192.168.1.20
# Full URL override, e.g. a .local name: LAN_URL=http://studio-box.local:4300
# MEDIA_RTMP_PORT=1935
# MEDIA_HLS_URL=http://127.0.0.1:8888
# MEDIA_API_URL=http://127.0.0.1:9997
# WEB_DIST=../../apps/web/dist
# DATA_DIR=./data
# MDNS=0 turns off the Bonjour advertisement
# DEV ONLY (ignored when NODE_ENV=production): skip the manager sign-in check on /box/*
# BOX_DEV_NO_AUTH=1
