# 7XEN Station (host service). Copy to .env — scripts/station-install.sh creates it with a random token.
# Shared secret: the API sends it as X-Station-Token, the station sends it back on its hooks.
# Must equal STATION_TOKEN in the repo-root .env (docker compose) / apps/api/.env (dev API).
STATION_TOKEN=
STATION_PORT=4500
# 0.0.0.0 so the API container can reach it via host.docker.internal (every request still needs the token)
STATION_HOST=0.0.0.0
# where the API listens, for the station's hooks (prod: the api container publishes 127.0.0.1:4000)
API_URL=http://127.0.0.1:4000
# same folder the API container mounts at /data/storage (default <repo>/storage); videos default to STORAGE_DIR/videos
#STORAGE_DIR=
#VIDEO_DIR=
# Android tooling (defaults under ~/.local/share/7xen-android)
#ADB=~/.local/share/7xen-android/sdk/platform-tools/adb
#SCRCPY=~/.local/share/7xen-android/scrcpy/scrcpy
#SCRCPY_SERVER_PATH=~/.local/share/7xen-android/scrcpy/scrcpy-server
#FFMPEG=~/.local/bin/ffmpeg
#ANDROID_HOME=~/.local/share/7xen-android/sdk
#ANDROID_AVD_HOME=~/.local/share/7xen-android/avd
AVD_NAME=bgmi14
DISPLAY=:0
# -feature -GLAsyncSwap: without it BGMI crashes in libEGL_emulation (createNativeSync) after ~20 s
#EMULATOR_ARGS=-gpu host -feature -GLAsyncSwap -no-boot-anim -no-snapshot-save
#ADB_SERIAL=emulator-5554
# Use an Android emulator/device on ANOTHER machine over Wi-Fi instead of the local AVD (e.g. a Mac running the
# Android emulator + scripts/mac-adb-relay.py). The station then never starts the local AVD.
#REMOTE_DEVICE=192.168.0.50:5556
# BlueStacks on a Mac through its stream API (docs/phase4/BLUESTACKS.md). When BLUESTACKS_URL is set the station
# uses it instead of adb/scrcpy/the local AVD: Start emulator / live control / Start match all go through it.
# URL = https://<mac-ip>:8080 (the Mac prints the token; it is in its .token file). The Mac's certificate is self-signed,
# so TLS verification is off by default; set BLUESTACKS_INSECURE_TLS=0 only if you installed a trusted cert.
#BLUESTACKS_URL=https://192.168.0.50:8080
#BLUESTACKS_TOKEN=
#BLUESTACKS_INSECURE_TLS=1
#BLUESTACKS_JOB_TIMEOUT_SEC=240
# capture: longest side in px (0 = native 2280), video bitrate (Mbps), fps
CAPTURE_MAX_SIZE=1280
CAPTURE_BITRATE_MBPS=6
CAPTURE_MAX_FPS=30
# HLS: segment target seconds, segments kept in the live playlist, minutes to keep the last playlist after a stop
HLS_TIME=2
HLS_LIST_SIZE=6
LIVE_KEEP_MIN=10
# logical = adb input uses the rotated screen's coordinates (Android 10+); natural = portrait panel
INPUT_COORDS=logical
LOG_LEVEL=info
